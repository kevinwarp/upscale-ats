# =============================================================================
# Upscale-ATS Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to version control.
# =============================================================================

# --- Enrichment Provider ---
# Configure your enrichment provider (e.g. Apollo, Hunter, Clearbit, etc.)
ENRICHMENT_PROVIDER=none  # none | apollo | hunter | clearbit | custom
ENRICHMENT_PROVIDER_API_KEY=your_provider_api_key_here
ENRICHMENT_PROVIDER_ENDPOINT=https://api.example.com/v1
ENRICHMENT_PROVIDER_TIMEOUT_MS=10000

# --- Enrichment Service ---
ATS_ENRICHMENT_TOKEN=your_shared_bearer_token_here
ENRICHMENT_SERVICE_PORT=3001
ENRICHMENT_SERVICE_URL=http://localhost:3001

# --- Rate Limiting ---
RATE_LIMIT_PER_USER_PER_DAY=60
RATE_LIMIT_GLOBAL_PER_DAY=500
CANDIDATE_COOLDOWN_DAYS=7

# --- Cost Controls ---
DAILY_COST_CAP_USD=50

# --- Database (OpenCATS MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=opencats
DB_USER=opencats
DB_PASSWORD=your_db_password_here

# --- OpenCATS ---
OPENCATS_URL=http://localhost:8080

# --- Slack Integration ---
SLACK_FEEDBACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx
SLACK_FEEDBACK_CHANNEL=#hiring
SLACK_BOT_TOKEN=xoxb-your-bot-token

# --- Interview Feedback ---
FEEDBACK_REMINDER_HOURS=24
FEEDBACK_LOCK_HOURS=48

# --- Google Calendar OAuth ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/v1/calendar/oauth/callback

# --- Pipeline ---
STALE_THRESHOLD_DAYS=7

# --- App ---
APP_BASE_URL=http://localhost:3001

# --- Node Environment ---
NODE_ENV=development
LOG_LEVEL=info
